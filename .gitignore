# ============================================================================
# Creator Console - Git Ignore Configuration
# ============================================================================
# This file tells Git which files and folders to NOT track.
# IMPORTANT: Never commit secrets, API keys, or credentials!
# ============================================================================

# ----------------------------------------------------------------------------
# Dependencies
# ----------------------------------------------------------------------------
# The node_modules folder contains all npm packages.
# It's huge and always regenerated by `npm install`, so we don't track it.
node_modules/
**/node_modules/

# ----------------------------------------------------------------------------
# Build Outputs
# ----------------------------------------------------------------------------
# These folders contain compiled/generated code.
# They're regenerated by build commands, so we don't track them.
lib/                    # TypeScript compiled output
**/lib/
dist/                   # Distribution builds
**/dist/
build/                  # Generic build output
**/build/

# ----------------------------------------------------------------------------
# Environment Files - CRITICAL SECURITY
# ----------------------------------------------------------------------------
# These files contain sensitive information like API keys and secrets.
# NEVER commit these to version control!
# 
# Instead, we commit .env.example files that show the structure without values.
.env
.env.local
.env.development
.env.production
.env.*.local
.env.dev
.env.prod
SYSTEM_DEPENDENCIES.md                 # System dependencies file (may contain secrets)
# ----------------------------------------------------------------------------
# Firebase
# ----------------------------------------------------------------------------
# Firebase generates these files during development and deployment.
.firebase/              # Firebase cache
firebase-debug.log      # Firebase CLI debug logs
firestore-debug.log     # Firestore emulator logs
ui-debug.log            # Firebase UI debug logs
*-debug.log             # Any debug logs

# ----------------------------------------------------------------------------
# HubSpot
# ----------------------------------------------------------------------------
# HubSpot CLI configuration (may contain auth tokens)
.hubspot/

# ----------------------------------------------------------------------------
# IDE and Editor Files
# ----------------------------------------------------------------------------
# These are personal editor settings that shouldn't be shared.
.idea/                  # JetBrains IDEs (WebStorm, etc.)
.vscode/                # VS Code settings (optional - some teams share these)
*.swp                   # Vim swap files
*.swo                   # Vim swap files
*.sublime-*             # Sublime Text files

# ----------------------------------------------------------------------------
# Operating System Files
# ----------------------------------------------------------------------------
# OS-specific files that provide no value in version control.
.DS_Store               # macOS folder metadata
.DS_Store?
._*                     # macOS resource forks
Thumbs.db               # Windows thumbnail cache
ehthumbs.db             # Windows thumbnail cache
Desktop.ini             # Windows folder settings

# ----------------------------------------------------------------------------
# Testing
# ----------------------------------------------------------------------------
# Test coverage reports are generated by test runners.
coverage/               # Jest/Vitest coverage reports
.nyc_output/            # NYC coverage output

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
# Log files can contain sensitive information and grow large.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
# Temporary files and caches
*.tmp
*.temp
.cache/
.parcel-cache/
.vite/
**/.vite/


# HubSpot local dev proxy — never commit
local.json
docs/SYSTEM_DEPENDENCIES.md
