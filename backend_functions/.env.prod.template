# Creator Console - Prod Environment Variables
# .env.prod is gitignored — never commit real secrets.
#
# To deploy to prod (only with explicit instruction):
#   firebase use prod && firebase deploy --only functions

# HubSpot
HUBSPOT_CLIENT_ID=INSERT-PROD-HUBSPOT-CLIENT-ID
HUBSPOT_CLIENT_SECRET=INSERT-PROD-HUBSPOT-CLIENT-SECRET
HUBSPOT_APP_ID=INSERT-PROD-HUBSPOT-APP-ID

# YouTube / Google OAuth
YOUTUBE_CLIENT_ID=INSERT-PROD-GOOGLE-CLIENT-ID
YOUTUBE_CLIENT_SECRET=INSERT-PROD-GOOGLE-CLIENT-SECRET

# Firebase / GCP
CLOUD_FUNCTIONS_REGION=us-central1

# AI Features (optional — AI cards disabled if not set)
GEMINI_API_KEY=INSERT-PROD-GEMINI-API-KEY