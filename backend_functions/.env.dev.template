# Creator Console - Dev Environment Variables
# Copy this file to .env.dev and fill in the values to set up your local development environment.

# .env.dev is gitignored — never commit real secrets.
#
# To deploy to dev:
#   firebase use dev && firebase deploy --only functions

# HubSpot
HUBSPOT_CLIENT_ID=INSERT-DEV-HUBSPOT-CLIENT-ID
HUBSPOT_CLIENT_SECRET=INSERT-DEV-HUBSPOT-CLIENT-SECRET
HUBSPOT_APP_ID=INSERT-DEV-HUBSPOT-APP-ID

# YouTube / Google OAuth
YOUTUBE_CLIENT_ID=INSERT-DEV-GOOGLE-CLIENT-ID
YOUTUBE_CLIENT_SECRET=INSERT-DEV-GOOGLE-CLIENT-SECRET

# Firebase / GCP
CLOUD_FUNCTIONS_REGION=us-central1

# AI Features (optional — AI cards disabled if not set)
GEMINI_API_KEY=INSERT-DEV-GEMINI-API-KEY